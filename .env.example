DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/widget_platform

# Rate limiting defaults
PUBLIC_SUBMISSION_RATE_LIMIT=10
PUBLIC_SUBMISSION_RATE_WINDOW_SECONDS=60

# Request size limits
MAX_PUBLIC_SUBMISSION_BYTES=65536

# Notification worker
NOTIFICATION_WEBHOOK_URL=https://httpbin.org/post